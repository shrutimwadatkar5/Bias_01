\citation{ganguli2023selfcorrection}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Mitigation results on the eight highest-disparity items. $p$ is a paired Wilcoxon test over the eight item-level composite scores (intervention vs.\ baseline); with $n=8$ the smallest attainable $p$ is 0.008. ``Words'' is the mean response length under the intervention.}}{11}{table.caption.11}\protected@file@percent }
\newlabel{tab:q1mit}{{7}{11}{Mitigation results on the eight highest-disparity items. $p$ is a paired Wilcoxon test over the eight item-level composite scores (intervention vs.\ baseline); with $n=8$ the smallest attainable $p$ is 0.008. ``Words'' is the mean response length under the intervention}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Disparity before and after the two interventions. Neither intervention produces a consistent reduction across models; the largest nominal improvement (Phi-3.5, I1, 0.718$\to $0.532) does not survive correction, and Mistral-7B becomes worse under I1.}}{11}{figure.caption.12}\protected@file@percent }
\newlabel{fig:mit}{{5}{11}{Disparity before and after the two interventions. Neither intervention produces a consistent reduction across models; the largest nominal improvement (Phi-3.5, I1, 0.718$\to $0.532) does not survive correction, and Mistral-7B becomes worse under I1}{figure.caption.12}{}}
