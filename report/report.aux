\@writefile{toc}{\contentsline {paragraph}{Noise dominates utility.}{15}{figure.caption.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces DP-SGD runs. $C$ is the clipping norm, $\sigma $ the noise multiplier, $\varepsilon _{\mathrm  {RDP}}$ and $\varepsilon _{\mathrm  {PRV}}$ the privacy budget at $\delta =10^{-5}$, ``clipped frac.'' the fraction of examples whose gradient exceeded $C$. The baseline is non-private. The three ablation rows use $C=1,\sigma =0.8$; the final row is the overfit baseline used only for the membership-inference experiment.}}{16}{table.caption.16}\protected@file@percent }
\newlabel{tab:q3runs}{{9}{16}{DP-SGD runs. $C$ is the clipping norm, $\sigma $ the noise multiplier, $\eps _{\mathrm {RDP}}$ and $\eps _{\mathrm {PRV}}$ the privacy budget at $\delta =10^{-5}$, ``clipped frac.'' the fraction of examples whose gradient exceeded $C$. The baseline is non-private. The three ablation rows use $C=1,\sigma =0.8$; the final row is the overfit baseline used only for the membership-inference experiment}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Test accuracy against the achieved privacy budget. Each point is one configuration; lower $\varepsilon $ means stronger privacy. The dashed and dotted lines are the two non-private baselines.}}{16}{figure.caption.17}\protected@file@percent }
\newlabel{fig:q3eps}{{8}{16}{Test accuracy against the achieved privacy budget. Each point is one configuration; lower $\eps $ means stronger privacy. The dashed and dotted lines are the two non-private baselines}{figure.caption.17}{}}
\citation{shokri2017membership}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Test accuracy per epoch for every configuration. Noise slows convergence and lowers the plateau; the $C=5,\sigma =1.2$ run is the clearest example of noise-dominated training.}}{17}{figure.caption.18}\protected@file@percent }
\newlabel{fig:q3curves}{{9}{17}{Test accuracy per epoch for every configuration. Noise slows convergence and lowers the plateau; the $C=5,\sigma =1.2$ run is the clearest example of noise-dominated training}{figure.caption.18}{}}
