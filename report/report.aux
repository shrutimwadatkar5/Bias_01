\@writefile{toc}{\contentsline {paragraph}{IID: federation is almost free.}{12}{figure.caption.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Moderate heterogeneity: a small, stable cost.}{12}{figure.caption.14}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Federated versus centralized results. ``Gap vs C.'' is centralized minus the method's final accuracy (positive means the federated model is worse). ``Rounds to 90\%'' is the first round reaching 90\% of that run's final accuracy. ``Client mean/std/min'' is the accuracy of the global model on the test examples whose labels a client owns. Communication is the total bytes transferred: model updates for FedAvg ($2\times $parameters$\times 4$ bytes$\times 5$ clients$\times 20$ rounds) and one upload of the raw training set for centralized training.}}{13}{table.caption.13}\protected@file@percent }
\newlabel{tab:q2runs}{{8}{13}{Federated versus centralized results. ``Gap vs C.'' is centralized minus the method's final accuracy (positive means the federated model is worse). ``Rounds to 90\%'' is the first round reaching 90\% of that run's final accuracy. ``Client mean/std/min'' is the accuracy of the global model on the test examples whose labels a client owns. Communication is the total bytes transferred: model updates for FedAvg ($2\times $parameters$\times 4$ bytes$\times 5$ clients$\times 20$ rounds) and one upload of the raw training set for centralized training}{table.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Test accuracy per communication round. IID tracks centralized training almost exactly. Dirichlet($\alpha {=}0.1$) converges more slowly and to a lower plateau; the two-class label skew peaks early and then oscillates as clients pull the global model towards their own labels.}}{13}{figure.caption.14}\protected@file@percent }
\newlabel{fig:q2curves}{{6}{13}{Test accuracy per communication round. IID tracks centralized training almost exactly. Dirichlet($\alpha {=}0.1$) converges more slowly and to a lower plateau; the two-class label skew peaks early and then oscillates as clients pull the global model towards their own labels}{figure.caption.14}{}}
\citation{zhu2019deep,shokri2017membership}
\citation{bonawitz2019towards}
\@writefile{toc}{\contentsline {paragraph}{Strong heterogeneity: slower and lower.}{14}{figure.caption.14}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Extreme label skew: the global model fails on some clients.}{14}{figure.caption.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: the global model's accuracy on the test examples whose labels each client owns. The two-class skew produces near-zero accuracy for one client while others remain above 0.9. Right: an example of the label imbalance induced by Dirichlet allocation.}}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:q2client}{{7}{14}{Left: the global model's accuracy on the test examples whose labels each client owns. The two-class skew produces near-zero accuracy for one client while others remain above 0.9. Right: an example of the label imbalance induced by Dirichlet allocation}{figure.caption.15}{}}
