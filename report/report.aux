\@writefile{toc}{\contentsline {section}{\numberline {3}Question 2: Federated averaging versus centralized training}{12}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Setup}{12}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Partitions}{12}{subsection.3.2}\protected@file@percent }
