\@writefile{toc}{\contentsline {paragraph}{Model-level disparity.}{6}{subsection.2.7}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Model-level audit summary. Disparity $z$ is the mean of the 20 item-level composite scores; mean $|\Delta s|$ is the mean absolute sentiment difference on the 0--1 probability scale; repeat consistency is the share of item--seed comparisons that agree in sign with the majority; refusal rate is the share of baseline responses that decline. ``Largest dimension'' is the dimension with the highest mean $z$ for that model.}}{6}{table.caption.4}\protected@file@percent }
\newlabel{tab:q1models}{{4}{6}{Model-level audit summary. Disparity $z$ is the mean of the 20 item-level composite scores; mean $|\Delta s|$ is the mean absolute sentiment difference on the 0--1 probability scale; repeat consistency is the share of item--seed comparisons that agree in sign with the majority; refusal rate is the share of baseline responses that decline. ``Largest dimension'' is the dimension with the highest mean $z$ for that model}{table.caption.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Dimension structure.}{6}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Signed sentiment is null; substance is not.}{6}{figure.caption.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Directive hypotheses are often reversed.}{6}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Composite disparity $z$ by dimension and model. Rows are the ten dimensions, columns the four models. Darker cells indicate larger normalised differences between the two counterfactual conditions. Language/code-switching and religious accommodation are the two hottest rows; socioeconomic status is dominated by the 1.5B model.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:heatmap}{{1}{7}{Composite disparity $z$ by dimension and model. Rows are the ten dimensions, columns the four models. Darker cells indicate larger normalised differences between the two counterfactual conditions. Language/code-switching and religious accommodation are the two hottest rows; socioeconomic status is dominated by the 1.5B model}{figure.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Mean composite disparity $z$ for each dimension and model. The final column is the unweighted mean over the four models. Values are computed from seed-averaged item-level deltas.}}{7}{table.caption.6}\protected@file@percent }
\newlabel{tab:q1dims}{{5}{7}{Mean composite disparity $z$ for each dimension and model. The final column is the unweighted mean over the four models. Values are computed from seed-averaged item-level deltas}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Item-level mean sentiment deltas with 95\% item-bootstrap confidence intervals. The intervals mostly straddle zero and the signs differ across items: pooled signed sentiment is not a useful bias statistic here. The absolute magnitudes, which enter the composite index, are non-zero.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:forest}{{2}{8}{Item-level mean sentiment deltas with 95\% item-bootstrap confidence intervals. The intervals mostly straddle zero and the signs differ across items: pooled signed sentiment is not a useful bias statistic here. The absolute magnitudes, which enter the composite index, are non-zero}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Directional hypothesis support. ``Supported'' counts items whose mean delta has the pre-specified sign; ``all three seeds'' additionally requires that sign in every seed. No significance threshold is applied here, so these counts are descriptive.}}{9}{table.caption.8}\protected@file@percent }
\newlabel{tab:q1hyp}{{6}{9}{Directional hypothesis support. ``Supported'' counts items whose mean delta has the pre-specified sign; ``all three seeds'' additionally requires that sign in every seed. No significance threshold is applied here, so these counts are descriptive}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two views of the same audit. Sentiment differences are small and sign-inconsistent (left); length differences are larger and systematically favour one condition within an item (right), especially for L1/L2 (language) and S1 (school type).}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:two_views}{{3}{9}{Two views of the same audit. Sentiment differences are small and sign-inconsistent (left); length differences are larger and systematically favour one condition within an item (right), especially for L1/L2 (language) and S1 (school type)}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {paragraph}{Qualitative evidence.}{9}{figure.caption.9}\protected@file@percent }
